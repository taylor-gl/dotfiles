! Burning Sun Paper — generated by theme/build.sh, do not edit
!
! Emitted with doom-themes variable names because .i3/config has always
! consumed them via set_from_resource. Under rubrication most of the named
! hues collapse onto the grey ramp; only the ember slots carry colour.

*i3wm.bg:         #ede8e0
*i3wm.bg-alt:     #e3ddd3
*i3wm.fg:         #0a0a0a
*i3wm.fg-alt:     #6b665e
*i3wm.base0:      #ede8e0
*i3wm.base1:      #e3ddd3
*i3wm.base2:      #cfc7b9
*i3wm.base3:      #9a9184
*i3wm.base4:      #9a9184
*i3wm.base5:      #6b665e
*i3wm.base6:      #6b665e
*i3wm.base7:      #0a0a0a
*i3wm.base8:      #050505

! The rubric. `ember` is the name the config should prefer; `red`/`orange`
! are kept as aliases so nothing that still references them breaks.
*i3wm.ember:      #ff4a00
*i3wm.ember-dim:  #c93a08
*i3wm.red:        #ff4a00
*i3wm.orange:     #c93a08
*i3wm.yellow:     #a83208

! Collapsed to the grey ramp — nothing in the WM earns a hue.
*i3wm.green:      #55504a
*i3wm.blue:       #6b665e
*i3wm.dark-blue:  #9a9184
*i3wm.teal:       #6b665e
