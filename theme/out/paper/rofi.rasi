/* Burning Sun Paper — generated by theme/build.sh, do not edit
 *
 * Replaces the stock Arc-Dark/Arc that switch-to-*-theme.sh used to select by
 * name. No frame, no rounding, no separators: the launcher is a sheet of the
 * same stock as everything else, and the only mark on it is the ember bar
 * against the selected row.
 */

* {
    bg:        #ede8e0;
    bg-alt:    #e3ddd3;
    sel:       #cfc7b9;
    fg:        #0a0a0a;
    fg-dim:    #6b665e;
    ember:     #ff4a00;

    background-color: transparent;
    text-color:       @fg;
    font:             "Iosevka Aile 12";
}

window {
    background-color: @bg;
    border:           1px;
    border-color:     @sel;
    padding:          0;
    width:            36em;
}

mainbox {
    padding:  0;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @bg;
    padding:          0.9em 1em;
    spacing:          0.6em;
    children:         [ prompt, entry ];
    border:           0 0 1px 0;
    border-color:     @sel;
}

/* The prompt is the rubric: small, letterspaced, ember — the eyebrow label
 * the site uses for nav and metadata. */
prompt {
    text-color: @ember;
    font:       "Iosevka Aile 10";
}

entry {
    text-color:        @fg;
    placeholder:       "";
    cursor:            text;
}

/* Fixed height: the window keeps its size as results are filtered out, so it
 * does not jump around under the cursor while typing. */
listview {
    lines:        10;
    scrollbar:    false;
    padding:      0.4em 0;
    fixed-height: true;
}

element {
    padding:    0.5em 1em;
    spacing:    0.7em;
    text-color: @fg-dim;
}

element normal.normal   { text-color: @fg-dim; }
element alternate.normal { text-color: @fg-dim; }

/* Selection: an ember rule down the left edge, nothing else. */
element selected.normal {
    background-color: @bg-alt;
    text-color:       @fg;
    border:           0 0 0 2px;
    border-color:     @ember;
}

element-icon {
    size:             1.1em;
    vertical-align:   0.5;
}

element-text {
    vertical-align: 0.5;
}

element selected.normal element-text {
    text-color: @fg;
}
