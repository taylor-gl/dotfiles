! Burning Sun Dark — generated by theme/build.sh, do not edit
!
! Emitted with doom-themes variable names because .i3/config has always
! consumed them via set_from_resource. Under rubrication most of the named
! hues collapse onto the grey ramp; only the ember slots carry colour.

*i3wm.bg:         #0a0a0a
*i3wm.bg-alt:     #141312
*i3wm.fg:         #ede8e0
*i3wm.fg-alt:     #8a8479
*i3wm.base0:      #0a0a0a
*i3wm.base1:      #141312
*i3wm.base2:      #262626
*i3wm.base3:      #5f5a52
*i3wm.base4:      #5f5a52
*i3wm.base5:      #8a8479
*i3wm.base6:      #8a8479
*i3wm.base7:      #ede8e0
*i3wm.base8:      #f6f3ee

! The rubric. `ember` is the name the config should prefer; `red`/`orange`
! are kept as aliases so nothing that still references them breaks.
*i3wm.ember:      #ff4a00
*i3wm.ember-dim:  #e8724a
*i3wm.red:        #ff4a00
*i3wm.orange:     #e8724a
*i3wm.yellow:     #d0553a

! Collapsed to the grey ramp — nothing in the WM earns a hue.
*i3wm.green:      #a8a196
*i3wm.blue:       #8a8479
*i3wm.dark-blue:  #5f5a52
*i3wm.teal:       #8a8479
*i3wm.magenta:    #a8a196
*i3wm.violet:     #5f5a52
*i3wm.cyan:       #a8a196
*i3wm.dark-cyan:  #5f5a52
*i3wm.gray:       #8a8479

! Terminal ANSI. The one carve-out: `git diff` and `ls` need hue to stay
! legible, so these are desaturated rather than greyed out.
*.foreground:  #ede8e0
*.background:  #0a0a0a
*.cursorColor: #ff4a00
