{
  "_comment": [
    "{{scheme-name}} — generated by dotfiles/theme/build.sh, do not edit.",
    "Monochrome and rubrication: the interface reads in grey, and vermilion is",
    "spent on the things that need finding — errors, permission prompts, the",
    "active mode. Subagent colours and diffs keep a distinction because",
    "removing it there would destroy meaning rather than noise."
  ],
  "name": "{{scheme-name}}",
  "_base_comment": [
    "dark-ansi / light-ansi, not dark / light. Inline `code` is rendered by a",
    "path that reads the BASE palette and ignores `overrides`, so with a plain",
    "dark base it stays rgb(177,185,249) — a periwinkle blue — no matter what",
    "we set. The -ansi bases spell that slot as ansi:blue / ansi:blueBright,",
    "which resolves through the terminal's own palette, and ours is grey.",
    "Every other token is overridden below, so the base only shows through on",
    "the paths that ignore overrides."
  ],
  "base": "{{#scheme-is-dark}}dark-ansi{{/scheme-is-dark}}{{#scheme-is-light}}light-ansi{{/scheme-is-light}}",
  "overrides": {
    "background": "#{{base00-hex}}",
    "text": "#{{base05-hex}}",
    "inverseText": "#{{base00-hex}}",
    "subtle": "#{{ramp-3-hex}}",
    "inactive": "#{{ramp-4-hex}}",
    "inactiveShimmer": "#{{ramp-5-hex}}",

    "claude": "#{{base08-hex}}",
    "claudeShimmer": "#{{base09-hex}}",
    "claudeBlue_FOR_SYSTEM_SPINNER": "#{{base04-hex}}",
    "claudeBlueShimmer_FOR_SYSTEM_SPINNER": "#{{ramp-6-hex}}",

    "suggestion": "#{{base08-hex}}",
    "remember": "#{{base09-hex}}",
    "skill": "#{{base09-hex}}",
    "permission": "#{{base08-hex}}",
    "permissionShimmer": "#{{base09-hex}}",
    "autoAccept": "#{{base09-hex}}",
    "autoAcceptShimmer": "#{{base0A-hex}}",
    "planMode": "#{{base04-hex}}",
    "fastMode": "#{{base08-hex}}",
    "fastModeShimmer": "#{{base09-hex}}",
    "effortUltra": "#{{base08-hex}}",
    "ide": "#{{base04-hex}}",
    "professionalBlue": "#{{base04-hex}}",
    "chromeYellow": "#{{base09-hex}}",

    "bashBorder": "#{{base02-hex}}",
    "promptBorder": "#{{base02-hex}}",
    "promptBorderShimmer": "#{{ramp-3-hex}}",
    "selectionBg": "#{{base02-hex}}",
    "userMessageBackground": "#{{base01-hex}}",
    "userMessageBackgroundHover": "#{{base02-hex}}",
    "composerSidebarBackground": "#{{base01-hex}}",
    "bashMessageBackgroundColor": "#{{base01-hex}}",
    "memoryBackgroundColor": "#{{base01-hex}}",

    "success": "#{{base05-hex}}",
    "error": "#{{base08-hex}}",
    "warning": "#{{base09-hex}}",
    "warningShimmer": "#{{base0A-hex}}",
    "merged": "#{{base0A-hex}}",

    "rate_limit_fill": "#{{base08-hex}}",
    "rate_limit_empty": "#{{base02-hex}}",

    "briefLabelYou": "#{{base04-hex}}",
    "briefLabelClaude": "#{{base08-hex}}",
    "clawd_body": "#{{base05-hex}}",
    "clawd_background": "#{{base00-hex}}",

    "diffAdded": "#{{diff-add-bg-hex}}",
    "diffRemoved": "#{{diff-del-bg-hex}}",
    "diffAddedDimmed": "#{{diff-add-dim-hex}}",
    "diffRemovedDimmed": "#{{diff-del-dim-hex}}",
    "diffAddedWord": "#{{diff-add-hl-hex}}",
    "diffRemovedWord": "#{{diff-del-hl-hex}}",

    "red_FOR_SUBAGENTS_ONLY": "#{{rainbow-0-hex}}",
    "orange_FOR_SUBAGENTS_ONLY": "#{{rainbow-1-hex}}",
    "green_FOR_SUBAGENTS_ONLY": "#{{rainbow-2-hex}}",
    "purple_FOR_SUBAGENTS_ONLY": "#{{rainbow-3-hex}}",
    "yellow_FOR_SUBAGENTS_ONLY": "#{{rainbow-4-hex}}",
    "blue_FOR_SUBAGENTS_ONLY": "#{{rainbow-5-hex}}",
    "cyan_FOR_SUBAGENTS_ONLY": "#{{ramp-6-hex}}",
    "pink_FOR_SUBAGENTS_ONLY": "#{{base0A-hex}}",
    "rainbow_red": "#{{sweep-0-hex}}",
