# {{scheme-name}} — generated by theme/build.sh, do not edit
#
# Written against the scheme's `extras.ansi` block rather than the stock
# base16 kitty template. Stock would map color1 (red) to base08 and color2
# (green) to base0B, which in this scheme means `git diff` comes out as ember
# against grey — unreadable. The ansi block is the carve-out where hue is
# allowed to survive, desaturated far enough to sit under the rubrication.

background            #{{base00-hex}}
foreground            #{{base05-hex}}
selection_background  #{{base02-hex}}
selection_foreground  #{{base05-hex}}

cursor                #{{base08-hex}}
cursor_text_color     #{{base00-hex}}

url_color             #{{base04-hex}}

# Window and tab chrome: black on black, separated by the ember only where
# focus needs to be unambiguous.
active_border_color   #{{base08-hex}}
inactive_border_color #{{base02-hex}}
bell_border_color     #{{base08-hex}}

active_tab_background   #{{base00-hex}}
active_tab_foreground   #{{base08-hex}}
