! {{scheme-name}} — generated by theme/build.sh, do not edit
!
! Emitted with doom-themes variable names because .i3/config has always
! consumed them via set_from_resource. Under rubrication most of the named
! hues collapse onto the grey ramp; only the ember slots carry colour.

*i3wm.bg:         #{{base00-hex}}
*i3wm.bg-alt:     #{{base01-hex}}
*i3wm.fg:         #{{base05-hex}}
*i3wm.fg-alt:     #{{base04-hex}}
*i3wm.base0:      #{{base00-hex}}
*i3wm.base1:      #{{base01-hex}}
*i3wm.base2:      #{{base02-hex}}
*i3wm.base3:      #{{base03-hex}}
*i3wm.base4:      #{{base03-hex}}
*i3wm.base5:      #{{base04-hex}}
*i3wm.base6:      #{{base04-hex}}
*i3wm.base7:      #{{base05-hex}}
*i3wm.base8:      #{{base06-hex}}

! The rubric. `ember` is the name the config should prefer; `red`/`orange`
! are kept as aliases so nothing that still references them breaks.
*i3wm.ember:      #{{base08-hex}}
*i3wm.ember-dim:  #{{base09-hex}}
*i3wm.red:        #{{base08-hex}}
*i3wm.orange:     #{{base09-hex}}
*i3wm.yellow:     #{{base0A-hex}}

! Collapsed to the grey ramp — nothing in the WM earns a hue.
*i3wm.green:      #{{base0B-hex}}
*i3wm.blue:       #{{base0C-hex}}
*i3wm.dark-blue:  #{{base03-hex}}
*i3wm.teal:       #{{base0C-hex}}
*i3wm.magenta:    #{{base0E-hex}}
*i3wm.violet:     #{{base03-hex}}
*i3wm.cyan:       #{{base0B-hex}}
*i3wm.dark-cyan:  #{{base03-hex}}
*i3wm.gray:       #{{base04-hex}}

! Terminal ANSI. The one carve-out: `git diff` and `ls` need hue to stay
! legible, so these are desaturated rather than greyed out.
*.foreground:  #{{base05-hex}}
*.background:  #{{base00-hex}}
*.cursorColor: #{{base08-hex}}
*.color0:  #{{ansi-black-hex}}
*.color1:  #{{ansi-red-hex}}
