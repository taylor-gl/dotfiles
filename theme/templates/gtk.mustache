/* {{scheme-name}} — GTK
 * Generated by dotfiles/theme/build.sh — do not edit.
 *
 * Adwaita-dark's window base is #242424, a charcoal that reads as grey next to
 * black terminals and an i3 desktop at #0a0a0a. Overriding only the accent (as
 * this file used to) left every GTK app and Chromium's window chrome sitting
 * on that charcoal. So the full named-colour set is redefined here from the
 * scheme instead, for GTK3, GTK4/libadwaita, and the colours Chromium reads
 * when its theme is set to GTK.
 */

/* --- GTK3 ------------------------------------------------------------- */
@define-color theme_bg_color            #{{base00-hex}};
@define-color theme_base_color          #{{base00-hex}};
@define-color theme_fg_color            #{{base05-hex}};
@define-color theme_text_color          #{{base05-hex}};

@define-color theme_selected_bg_color   #{{base08-hex}};
@define-color theme_selected_fg_color   #{{base00-hex}};

@define-color theme_unfocused_bg_color      #{{base00-hex}};
@define-color theme_unfocused_base_color    #{{base00-hex}};
@define-color theme_unfocused_fg_color      #{{base05-hex}};
@define-color theme_unfocused_text_color    #{{base05-hex}};
@define-color theme_unfocused_selected_bg_color #{{base08-hex}};
@define-color theme_unfocused_selected_fg_color #{{base00-hex}};

@define-color insensitive_bg_color      #{{base01-hex}};
@define-color insensitive_fg_color      #{{base04-hex}};
@define-color insensitive_base_color    #{{base01-hex}};

@define-color borders                   #{{base02-hex}};
@define-color unfocused_borders         #{{base02-hex}};

@define-color warning_color             #{{base09-hex}};
@define-color error_color               #{{base08-hex}};
@define-color success_color             #{{base05-hex}};
@define-color destructive_color         #{{base08-hex}};

@define-color wm_bg                     #{{base00-hex}};
@define-color wm_border                 #{{base02-hex}};
@define-color wm_title                  #{{base05-hex}};
@define-color wm_unfocused_title        #{{base04-hex}};

@define-color content_view_bg           #{{base00-hex}};
@define-color text_view_bg              #{{base00-hex}};

/* --- GTK4 / libadwaita ------------------------------------------------ */
@define-color window_bg_color     #{{base00-hex}};
@define-color window_fg_color     #{{base05-hex}};
@define-color view_bg_color       #{{base00-hex}};
@define-color view_fg_color       #{{base05-hex}};
@define-color headerbar_bg_color  #{{base01-hex}};
@define-color headerbar_fg_color  #{{base05-hex}};
@define-color headerbar_border_color #{{base02-hex}};
@define-color popover_bg_color    #{{base01-hex}};
@define-color popover_fg_color    #{{base05-hex}};
@define-color card_bg_color       #{{base01-hex}};
@define-color card_fg_color       #{{base05-hex}};
@define-color dialog_bg_color     #{{base01-hex}};
@define-color dialog_fg_color     #{{base05-hex}};
@define-color sidebar_bg_color    #{{base01-hex}};
@define-color sidebar_fg_color    #{{base05-hex}};
@define-color sidebar_border_color #{{base02-hex}};
@define-color sidebar_backdrop_color #{{base00-hex}};

@define-color accent_bg_color     #{{base08-hex}};
@define-color accent_fg_color     #{{base00-hex}};
@define-color accent_color        #{{base08-hex}};

@define-color destructive_bg_color #{{base08-hex}};
@define-color destructive_fg_color #{{base00-hex}};
@define-color success_bg_color     #{{base05-hex}};
@define-color success_fg_color     #{{base00-hex}};
@define-color warning_bg_color     #{{base09-hex}};
@define-color warning_fg_color     #{{base00-hex}};
@define-color error_bg_color       #{{base08-hex}};
@define-color error_fg_color       #{{base00-hex}};

/* Concrete widget rules.
 *
 * The @define-color block above is not enough on its own: current Adwaita
 * hardcodes most of its surfaces rather than reading those names, so the
 * overrides were being ignored and windows kept Adwaita's own #f6f5f4 /
 * #242424. Chromium also samples real widget style contexts rather than the
 * named colours, so the browser's chrome and its vertical tab strip only
 * follow if the surfaces themselves are restyled. */

window,
dialog,
.background,
.solid-csd,
headerbar,
.titlebar,
notebook,
notebook > header,
notebook > header > tabs > tab:checked,
paned,
viewport,
scrolledwindow,
toolbar,
actionbar,
statusbar,
infobar {
  background-color: #{{base00-hex}};
  color: #{{base05-hex}};
}

/* Content surfaces — the "base" colour in GTK terms. */
textview,
textview text,
treeview.view,
.view,
list,
listbox,
iconview,
entry,
spinbutton,
searchbar entry {
  background-color: #{{base00-hex}};
  color: #{{base05-hex}};
}

/* Raised surfaces sit one step off the ground. */
popover,
popover.background,
menu,
.menu,
.context-menu,
tooltip,
tooltip.background,
notebook > header > tabs > tab {
  background-color: #{{base01-hex}};
  color: #{{base05-hex}};
}

button,
combobox button,
headerbar button {
  background-image: none;
  background-color: #{{base01-hex}};
  color: #{{base05-hex}};
  border-color: #{{base02-hex}};
}

button:hover { background-color: #{{base02-hex}}; }

button:active,
button:checked {
  background-color: #{{base08-hex}};
  color: #{{base00-hex}};
}

separator,
.separator {
  background-color: #{{base02-hex}};
  color: #{{base02-hex}};
}

label:disabled,
button:disabled,
*:disabled { color: #{{base04-hex}}; }

/* Selection is the one lit thing, as everywhere else. */
selection,
*:selected,
*:selected:focus {
  background-color: #{{base08-hex}};
  color: #{{base00-hex}};
}
