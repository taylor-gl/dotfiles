/* ---------------------------------------------------------------------
 * {{scheme-name}}
 * Generated by dotfiles/theme/build.sh — do not edit.
 *
 * Monochrome and rubrication: grey value and italic carry the structure,
 * vermilion is spent on headings, links and the things that must be found
 * by eye. Diffs and callouts keep a distinction because removing it there
 * would destroy meaning rather than noise.
 * ------------------------------------------------------------------ */

{{#scheme-is-dark}}.theme-dark{{/scheme-is-dark}}{{#scheme-is-light}}.theme-light{{/scheme-is-light}} {
  --bs-bg:        #{{base00-hex}};
  --bs-bg-alt:    #{{base01-hex}};
  --bs-line:      #{{base02-hex}};
  --bs-faint:     #{{base03-hex}};
  --bs-muted:     #{{base04-hex}};
  --bs-ink:       #{{base05-hex}};
  --bs-ink-bright:#{{base06-hex}};
  --bs-ember:     #{{base08-hex}};
  --bs-ember-dim: #{{base09-hex}};
  --bs-ember-deep:#{{base0A-hex}};

  /* Surfaces */
  --background-primary:       var(--bs-bg);
  --background-primary-alt:   var(--bs-bg-alt);
  --background-secondary:     var(--bs-bg);
  --background-secondary-alt: var(--bs-bg-alt);
  --background-modifier-border:        var(--bs-line);
  --background-modifier-border-hover:  var(--bs-muted);
  --background-modifier-border-focus:  var(--bs-ember);
  --background-modifier-hover:         var(--bs-bg-alt);
  --background-modifier-active-hover:  var(--bs-line);
  --background-modifier-form-field:    var(--bs-bg-alt);
  --background-modifier-error:         #{{diff-del-bg-hex}};
  --background-modifier-error-hover:   #{{diff-del-hl-hex}};
  --background-modifier-success:       #{{diff-add-bg-hex}};
  --background-modifier-message:       var(--bs-bg-alt);
  --titlebar-background:               var(--bs-bg);
  --titlebar-background-focused:       var(--bs-bg);
  --divider-color:                     var(--bs-line);
  --scrollbar-thumb-bg:                var(--bs-line);
  --scrollbar-active-thumb-bg:         var(--bs-muted);
  --scrollbar-bg:                      transparent;

  /* Text */
  --text-normal:      var(--bs-ink);
  --text-muted:       var(--bs-muted);
  --text-faint:       var(--bs-faint);
  --text-on-accent:   var(--bs-bg);
  --text-error:       var(--bs-ember);
  --text-success:     var(--bs-ink);
  --text-warning:     var(--bs-ember-deep);
  --text-accent:      var(--bs-ember);
  --text-accent-hover:var(--bs-ember-dim);
  --text-selection:   #{{base02-hex}};
  --text-highlight-bg:#{{diff-mod-hl-hex}};
  --text-blockquote:  var(--bs-muted);

  /* Interactive */
  --interactive-normal:      var(--bs-bg-alt);
  --interactive-hover:       var(--bs-line);
  --interactive-accent:      var(--bs-ember);
  --interactive-accent-hover:var(--bs-ember-dim);
  --color-accent:            var(--bs-ember);
  --color-accent-1:          var(--bs-ember);
  --color-accent-2:          var(--bs-ember-dim);
  --caret-color:             var(--bs-ember);

  /* Headings: the illuminated initial is ember, the rest step down in grey. */
  --h1-color: var(--bs-ember);
  --h2-color: var(--bs-ink);
  --h3-color: var(--bs-ink);
  --h4-color: var(--bs-muted);
  --h5-color: var(--bs-muted);
  --h6-color: var(--bs-faint);

  --link-color:            var(--bs-ink);
  --link-color-hover:      var(--bs-ember);
  --link-unresolved-color: var(--bs-muted);
  --link-external-color:   var(--bs-ink);
  --link-external-color-hover: var(--bs-ember);

  --blockquote-border-color: var(--bs-ember);
  --hr-color:                var(--bs-line);
  --bold-color:              var(--bs-ink-bright);
  --italic-color:            var(--bs-ink);
  --tag-color:               var(--bs-ember-dim);
  --tag-background:          var(--bs-bg-alt);
  --checkbox-color:          var(--bs-ember);
  --checkbox-color-hover:    var(--bs-ember-dim);
  --checkbox-border-color:   var(--bs-muted);
  --checklist-done-color:    var(--bs-faint);
  --list-marker-color:       var(--bs-ember);
  --blockquote-background-color: transparent;

  /* Code */
  --code-background: var(--bs-bg-alt);
  --code-normal:     var(--bs-ink);
  --code-comment:    var(--bs-faint);
  --code-function:   var(--bs-ink);
  --code-important:  var(--bs-ember);
  --code-keyword:    var(--bs-muted);
  --code-operator:   var(--bs-muted);
  --code-property:   var(--bs-ink);
  --code-punctuation:var(--bs-muted);
  --code-string:     var(--bs-muted);
  --code-tag:        var(--bs-ember);
  --code-value:      var(--bs-ember-dim);

  /* Type — the same family as the rest of the desktop. Aile and Etoile are
   * Iosevka's proportional cuts: genuinely variable-width, sharing the mono's
   * skeleton, so nothing on screen is foreign to anything else. */
  --font-text-theme:      "Iosevka Etoile", Georgia, serif;
  --font-interface-theme: "Iosevka Aile", ui-sans-serif, system-ui, sans-serif;
  --font-monospace-theme: "Iosevka Nerd Font Mono", ui-monospace, monospace;

  --bold-weight: 600;
  --h1-weight: 600;
  --h2-weight: 600;
  --h3-weight: 500;

  --graph-line:       var(--bs-line);
  --graph-node:       var(--bs-muted);
  --graph-node-tag:   var(--bs-ember-dim);
  --graph-node-attachment: var(--bs-faint);
  --graph-node-focused:    var(--bs-ember);
  --graph-node-unresolved: var(--bs-faint);
}

/* An ember hairline under the first heading, echoing the site's rule. */
{{#scheme-is-dark}}.theme-dark{{/scheme-is-dark}}{{#scheme-is-light}}.theme-light{{/scheme-is-light}} .markdown-preview-view h1::after,
{{#scheme-is-dark}}.theme-dark{{/scheme-is-dark}}{{#scheme-is-light}}.theme-light{{/scheme-is-light}} .markdown-rendered h1::after {
  content: "";
  display: block;
  width: 4.5rem;
  height: 1px;
  margin-top: 0.5rem;
  background: var(--bs-ember);
}

/* Active tab and the active line in the sidebar carry the ember rule rather
   than a filled highlight — the same treatment the rofi launcher uses. */
{{#scheme-is-dark}}.theme-dark{{/scheme-is-dark}}{{#scheme-is-light}}.theme-light{{/scheme-is-light}} .workspace-tab-header.is-active {
  box-shadow: inset 2px 0 0 var(--bs-ember);
}

/* Where colour is information: callouts keep a severity ramp, and diffs in
   fenced blocks keep add/remove, on the same logic as the terminal. */
{{#scheme-is-dark}}.theme-dark{{/scheme-is-dark}}{{#scheme-is-light}}.theme-light{{/scheme-is-light}} {
  --callout-bug:      {{base08-rgb-r}}, {{base08-rgb-g}}, {{base08-rgb-b}};
  --callout-important:{{base08-rgb-r}}, {{base08-rgb-g}}, {{base08-rgb-b}};
  --callout-error:    {{base08-rgb-r}}, {{base08-rgb-g}}, {{base08-rgb-b}};
  --callout-fail:     {{base08-rgb-r}}, {{base08-rgb-g}}, {{base08-rgb-b}};
  --callout-warning:  {{base09-rgb-r}}, {{base09-rgb-g}}, {{base09-rgb-b}};
  --callout-question: {{base09-rgb-r}}, {{base09-rgb-g}}, {{base09-rgb-b}};
  --callout-todo:     {{base0A-rgb-r}}, {{base0A-rgb-g}}, {{base0A-rgb-b}};
  --callout-info:     {{base04-rgb-r}}, {{base04-rgb-g}}, {{base04-rgb-b}};
  --callout-note:     {{base04-rgb-r}}, {{base04-rgb-g}}, {{base04-rgb-b}};
  --callout-abstract: {{base04-rgb-r}}, {{base04-rgb-g}}, {{base04-rgb-b}};
  --callout-tip:      {{base04-rgb-r}}, {{base04-rgb-g}}, {{base04-rgb-b}};
  --callout-example:  {{base04-rgb-r}}, {{base04-rgb-g}}, {{base04-rgb-b}};
  --callout-quote:    {{base03-rgb-r}}, {{base03-rgb-g}}, {{base03-rgb-b}};
  --callout-success:  {{base05-rgb-r}}, {{base05-rgb-g}}, {{base05-rgb-b}};
  --callout-done:     {{base05-rgb-r}}, {{base05-rgb-g}}, {{base05-rgb-b}};
  --callout-check:    {{base05-rgb-r}}, {{base05-rgb-g}}, {{base05-rgb-b}};
}

{{#scheme-is-dark}}.theme-dark{{/scheme-is-dark}}{{#scheme-is-light}}.theme-light{{/scheme-is-light}} .token.inserted,
{{#scheme-is-dark}}.theme-dark{{/scheme-is-dark}}{{#scheme-is-light}}.theme-light{{/scheme-is-light}} .token.deleted {
  padding: 0 2px;
}
{{#scheme-is-dark}}.theme-dark{{/scheme-is-dark}}{{#scheme-is-light}}.theme-light{{/scheme-is-light}} .token.inserted {
  color: var(--bs-ink);
  background: #{{diff-add-bg-hex}};
}
{{#scheme-is-dark}}.theme-dark{{/scheme-is-dark}}{{#scheme-is-light}}.theme-light{{/scheme-is-light}} .token.deleted {
  color: var(--bs-ember);
  background: #{{diff-del-bg-hex}};
}
