# {{scheme-name}} — generated by theme/build.sh, do not edit
#
# Merged into lazygit/config.yml by build.sh. Diff colours come from the ANSI
# carve-out for the same reason kitty's do: a diff with no hue is not a diff.

gui:
  theme:
    activeBorderColor:
      - "#{{base08-hex}}"
      - bold
    inactiveBorderColor:
      - "#{{base02-hex}}"
    searchingActiveBorderColor:
      - "#{{base08-hex}}"
      - bold
    optionsTextColor:
      - "#{{base04-hex}}"
    selectedLineBgColor:
      - "#{{base02-hex}}"
    inactiveViewSelectedLineBgColor:
      - "#{{base01-hex}}"
    cherryPickedCommitFgColor:
      - "#{{base00-hex}}"
    cherryPickedCommitBgColor:
      - "#{{base08-hex}}"
    markedBaseCommitFgColor:
      - "#{{base00-hex}}"
    markedBaseCommitBgColor:
      - "#{{base09-hex}}"
    unstagedChangesColor:
      - "#{{ansi-red-hex}}"
    defaultFgColor:
      - "#{{base05-hex}}"
